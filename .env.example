# Values must be configured in server secret stores, never in frontend files.
# Choose a NEW random server-to-server secret for the packaged source revision.
GATEWAY_SECRET=
# Supabase Edge Function expects the SHA-256 hex digest of that same secret.
SAINT_GATEWAY_SHA256=
# Supabase supplies SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY to its Edge runtime.
# Do not paste a service-role key into Cloudflare frontend source or this chat.
